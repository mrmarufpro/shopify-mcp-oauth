{
  "name": "shopify-mcp-oauth",
  "version": "0.1.0",
  "description": "OAuth 2.1 authorization + resource server for a Shopify app's MCP endpoint",
  "license": "MIT",
  "author": "Md Maruf Ahmed <maruffamd@gmail.com> (https://github.com/mrmarufpro)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrmarufpro/shopify-mcp-oauth.git",
    "directory": "packages/shopify-mcp-oauth"
  },
  "homepage": "https://github.com/mrmarufpro/shopify-mcp-oauth#readme",
  "bugs": "https://github.com/mrmarufpro/shopify-mcp-oauth/issues",
  "keywords": [
    "shopify",
    "mcp",
    "model-context-protocol",
    "oauth",
    "oauth2",
    "oauth2.1",
    "pkce",
    "express",
    "authorization-server",
    "resource-server"
  ],
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.2"
  },
  "peerDependencies": {
    "express": ">=5",
    "vitest": ">=2.0",
    "zod": ">=3.23"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "express": "^5.0.0",
    "supertest": "^7.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
